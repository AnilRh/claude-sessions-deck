{
  "Author": "Anil Rhemtulla",
  "Name": "Claude Sessions",
  "Description": "Live status board for concurrent Claude Code and OpenAI Codex sessions",
  "Icon": "assets/store-icon.png",
  "Version": "1.2.0",
